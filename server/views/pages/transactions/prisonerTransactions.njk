{% extends "../../partials/layout.njk" %}
{% from "../../components/AccountNavigation.njk" import AccountNavigation %}

{% block content %}

{% set rows = [] %}
{% for row in transactions %}
  {%- set amountClasses = "amount" -%}
  {%- set amount = (row.amount | penceToPound) -%}
  {% set rowData = {
      displayDate: row.date,
      description : row.description,
      amount: amount,
      accountType: row.accountType,
      location : row.location,
      isStatementBalance: row.isStatementBalance,
      subAccountBalance : row.subAccountBalance | penceToPound
  }
    %}
  {% set rows = (rows.push(rowData), rows) %}
{% endfor %}


<h3 class="govuk-heading-l">{{prisonNumber}}</h3>
<br>

{{ AccountNavigation(prisonNumber, subAccount) }}

<table class="govuk-table" data-testid="prisoner-transactions-table">
  <thead class="govuk-table__head">
  <tr class="govuk-table__row">
    <th class="govuk-table__header">Date</th>
    <th class="govuk-table__header">Description</th>
    <th class="govuk-table__header">Amount</th>
    <th class="govuk-table__header">Sub Account Balance</th>
    <th class="govuk-table__header">Location</th>
    <th class="govuk-table__header">Account Type</th>
  </tr>
  </thead>
  <tbody class="govuk-table__body">
  {% for row in rows %}
    {% if row.isStatementBalance %}
        <tr class="govuk-table__row statement-balance-bold-row" >
            <td class="govuk-table__cell">{{row.displayDate | formatDate}}</td>
            <td class="govuk-table__cell">{{row.description}}</td>
            <td class="govuk-table__cell">{{row.amount}}</td>
            <td class="govuk-table__cell">{{row.subAccountBalance}}</td>
            <td class="govuk-table__cell">{{row.location}}</td>
            <td class="govuk-table__cell">{{row.accountType}}</td>
        </tr>
      {% else %}
        <tr>
            <td class="govuk-table__cell">{{row.displayDate | formatDate}}</td>
            <td class="govuk-table__cell">{{row.description}}</td>
            <td class="govuk-table__cell">{{row.amount}}</td>
            <td class="govuk-table__cell">{{row.subAccountBalance}}</td>
            <td class="govuk-table__cell">{{row.location}}</td>
            <td class="govuk-table__cell">{{row.accountType}}</td>
        </tr>
      {% endif %}
  {% endfor %}
  </tbody>
</table>
{% endblock %}
