{% extends "../../partials/layout.njk" %}
{% from "../../components/AccountNavigation.njk" import AccountNavigation %}

{% block content %}


<h3 class="govuk-heading-l">{{prisonNumber}}</h3>
<br>

{{ AccountNavigation(prisonNumber, subAccount) }}

<table class="govuk-table" data-testid="prisoner-transactions-table">
    <thead class="govuk-table__head">
    <tr class="govuk-table__row">
        <th class="govuk-table__header">NOM_ID</th>
        <th class="govuk-table__header">Ref</th>
        <th class="govuk-table__header">CreatedAt</th>
        <th class="govuk-table__header">CreatedBy</th>
        <th class="govuk-table__header">FromDate</th>
        <th class="govuk-table__header">UntilDate</th>
        <th class="govuk-table__header">IsReleased</th>
        <th class="govuk-table__header">Description</th>
        <th class="govuk-table__header">Type</th>
        <th class="govuk-table__header">Amount</th>
        <th class="govuk-table__header">Location</th>
    </tr>
    </thead>
    <tbody class="govuk-table__body">
    {% for hold in holds %}
        <tr class="govuk-table__row" >
            <td class="govuk-table__cell">{{ hold.legacyHoldNumber }}</td>
            <td class="govuk-table__cell">{{ hold.subAccountRef }}</td>
            <td class="govuk-table__cell">{{ hold.createdAt | formatDateForView | safe}}</td>
            <td class="govuk-table__cell">{{ hold.createdBy }}</td>
            <td class="govuk-table__cell">{{ hold.holdFromDate | formatDate}}</td>
            <td class="govuk-table__cell">{{ hold.holdUntilDate | formatDate}}</td>
            <td class="govuk-table__cell">{{ hold.isReleased }}</td>
            <td class="govuk-table__cell">{{ hold.description }}</td>
            <td class="govuk-table__cell">{{ hold.holdType }}</td>
            <td class="govuk-table__cell">{{ hold.amount | penceToPound }}</td>
            <td class="govuk-table__cell">{{ hold.holdLocation }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
